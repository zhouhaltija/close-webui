# Copy values into the ignored repository-root .env.backend.local.
# Generate ENCRYPTION_KEY as base64-encoded 32 cryptographically random bytes.
DATABASE_URL=postgresql://closewebui:change-me@127.0.0.1:5432/closewebui_dev?sslmode=disable
ENCRYPTION_KEY=
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
STATIC_DIR=../dist
# Exact host:port entries, only when explicitly allowing a private gateway.
UPSTREAM_ALLOWED_HOSTS=
# Production: HTTPS origin, COOKIE_SECURE=true, and PostgreSQL sslmode=require or verify-full.
